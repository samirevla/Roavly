# Standalone auth (email + password). Sites identity headers are OFF by default.
# Set to 1 only when running behind OpenAI Sites / a trusted edge that injects
# oai-authenticated-user-* headers. Never enable on a public standalone deploy.
ROAVLY_ALLOW_SITES_HEADERS=0
AUTH_SESSION_DAYS=30

# Web maps
GOOGLE_MAPS_API_KEY=replace_with_restricted_browser_key
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Stripe Checkout, Billing and Connect
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_ROAVLY_PLUS_MONTHLY_PRICE_ID=price_replace_me
STRIPE_ROAVLY_PLUS_ANNUAL_PRICE_ID=price_replace_me

# Roavly administration and configurable monetization defaults
ROAVLY_ADMIN_EMAILS=owner@example.com
ROAVLY_BILLING_CURRENCY=usd
ROAVLY_TIP_DEFAULT_PRICE_CENTS=99
ROAVLY_TIP_MAX_PRICE_CENTS=499
ROAVLY_PLATFORM_FEE_PERCENT=30
ROAVLY_PLUS_TIP_CREDITS=3
ROAVLY_TIP_CREDIT_VALUE_CENTS=69
ROAVLY_FREE_SAVE_LIMIT=10
ROAVLY_TIP_BUNDLE_SIZE=5
ROAVLY_TIP_BUNDLE_PRICE_CENTS=399
ROAVLY_SELLER_FOLLOWER_THRESHOLD=25
ROAVLY_SELLER_UPVOTE_THRESHOLD=50

# Signed same-origin tip media uploads (staging/production secret)
UPLOAD_SIGNING_SECRET=replace_with_long_random_secret
